{
  "name": "universal-diy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Universal DIY — parametric cut lists for simple butt-joint boxes, entirely in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
